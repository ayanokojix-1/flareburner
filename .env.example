# flareburner configuration — copy to .env and edit.
# All values are optional; sensible defaults are shown.

# Port the HTTP API listens on.
PORT=4001

# Optional API key. If set, POST /v1 requires:
#   X-API-Key: <key>            (or)   Authorization: Bearer <key>
# Leave empty to keep the API open.
API_KEY=

# Number of warm Chrome instances (max concurrent requests).
POOL_SIZE=1

# Run Chrome headless. Cloudflare is harder to beat headless; keep false
# unless you know your target doesn't challenge.
HEADLESS=false

# Navigation + Cloudflare-wait timeout, in milliseconds.
NAV_TIMEOUT=60000

# URL used when a request omits "url".
DEFAULT_URL=

# Verbose logging. When on, logs each request, why the no-Chrome fast-path fell
# back to the browser, and transient-error retries. Errors are always logged.
DEBUG=false

# Residential/mobile proxy. On a datacenter host (DigitalOcean, AWS, …) the
# datacenter IP is what Cloudflare flags — not the browser. Route through a
# residential/mobile proxy and it behaves like a home connection.
# Both the browser solve AND the cookie-reuse fetches go through this proxy
# (cf_clearance is bound to the exit IP, so they must match). Leave PROXY_HOST
# empty for a direct connection.
#   Webshare gives you host:port + user:pass — paste them here.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
